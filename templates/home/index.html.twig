{%extends 'base.html.twig' %}

{#
    sobreescribimos el titulo de la pagina, usamos la variable title, el cual vendrá desde el controlador
#}
{% block title %}{{ projectName }}{% endblock %}

{%block content%}
    <p class="eyebrow">IFCT092PO - {{ projectName }}</p>
    {# projectName debe venir desde el controlador #}
    <h1>{{ projectName }}</h1>
    {# message debe venir desde el controlador #}
    <p>{{ message }}</p>
    {#  Generamos el enlace a incidencias usando el nombre Symfony de la ruta #}
    <p><a class="button" href="{{ path('app_ticket_index') }}">Ver incidencias</a></p>
{%endblock%}