<article class="ticket-card">
    <div class="ticket-code">
        <p class="ticket-code">Code: {{ticket.code}}</p>
        <h2>{{ ticket.title }}</h2>
        <p class="ticket-priority">Prioridad: {{ ticket.priority.label }}</p>
    </div>
    <a class="button" href="{{ path('app_ticket_show', {'code': ticket.code}) }}">Ver incidencia</a>
</article>