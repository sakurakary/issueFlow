
{% extends 'base.html.twig' %}

{% block title %}{{ ticket.id }} - {{ ticket.title }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <p class="eyebrow">IFCT092PO - {{ ticket.id }} - {{ ticket.title }}</p>
            <h1>{{ ticket.title }}</h1>
        </div>
    </div>

    <div class="ticket-details">
        <p><strong>ID:</strong> {{ ticket.id }}</p>
        <p><strong>Título:</strong> {{ ticket.title }}</p>
        <p><strong>Prioridad:</strong> {{ ticket.priority.label }}</p>
        <p><strong>Estado:</strong> {{ ticket.status.label }}</p>
        <p><strong>Usuario:</strong> {{ ticket.user }}</p>
        <p><strong>Descripcion:</strong> {{ ticket.description }}</p>
        <p style="color: {{ responseTargetHours == 4 ? 'red' : 'black' }}"><strong>Tiempo de respuesta:</strong> {{ responseTargetHours }}
    </div>

    {#
        Quiero mostrar un mensaje solo si priority es 'urgent'. ticket.urgen resuelve el metodo isUrgetn()
    #}
    {% if ticket.urgent %}
        <div class="alert alert-danger">
            <strong>¡Atención!</strong> Esta incidencia es urgente. Requiere atención inmediata
        </div>
    {% endif %}

    {#
        Quiero mostrar un mensaje solo si status es 'open'. ticket.open resuelve el metodo isOpen()
    #}
    {% if not ticket.open %}
        <div class="alert alert-warning">
            <p><strong>Esta incidencia ya está siendo gestionada o está cerrada</strong></p>
        </div>
    {% endif %}

    <a class="button" href="{{ path('app_ticket_index') }}">Volver a la lista de incidencias</a>
{% endblock %}